{
  "name": "impasto",
  "productName": "Impasto",
  "version": "1.3.0",
  "description": "Open-source store for lossless painted wallpapers",
  "main": "main.js",
  "license": "MIT",
  "author": "Impasto contributors",
  "scripts": {
    "stage": "node ../tools/stage.mjs www desktop",
    "start": "npm run stage && electron .",
    "dist:win": "npm run stage && electron-builder --win --x64",
    "dist:mac": "npm run stage && electron-builder --mac --arm64 && electron-builder --mac --x64"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.impasto.wallpapers",
    "productName": "Impasto",
    "copyright": "Impasto contributors, MIT",
    "directories": {
      "output": "../dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "build/icon.png",
      "www/**/*"
    ],
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Impasto-Setup-${version}.exe",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "Impasto-${version}-portable.exe"
    },
    "publish": null,
    "afterPack": "./adhoc-sign.js",
    "mac": {
      "target": [
        {
          "target": "dmg"
        }
      ],
      "icon": "build/icon-mac.png",
      "identity": null,
      "category": "public.app-category.graphics-design",
      "darkModeSupport": true,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Impasto sets your desktop picture through System Events."
      }
    },
    "dmg": {
      "artifactName": "Impasto-${version}-mac-${arch}.dmg"
    }
  },
  "repository": "https://github.com/MohammedAnasAsif/Impasto"
}